# L4T container for running openpilot ACC bridge on NVIDIA Jetson.
#
# Uses DeepStream base image for hardware-accelerated video processing:
#   - nvjpegdec / nvv4l2decoder for camera decode
#   - nvvideoconvert for GPU-accelerated resize and color conversion
#   - GStreamer pipeline with NVIDIA plugins
#   - TensorRT for GPU-accelerated neural network inference (modeld)
#
# Build:
#   docker build -f Dockerfile.l4t -t acc-bridge-l4t ../..
#
# Run:
#   ./run_jetson.sh --game-host 192.168.1.100
#
# Tested on: Jetson Orin (JetPack 6.x / L4T R36.x)
# For JetPack 5.x, change the base image tag to 6.3-samples or 6.4-samples

ARG DEEPSTREAM_TAG=7.1-samples-multiarch
FROM nvcr.io/nvidia/deepstream-l4t:${DEEPSTREAM_TAG}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1

# System dependencies for openpilot + GStreamer Python bindings + OpenCL + modeld
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    python3-gi \
    python3-gst-1.0 \
    gir1.2-gst-plugins-base-1.0 \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    v4l-utils \
    libzmq3-dev \
    libcapnp-dev \
    capnproto \
    libffi-dev \
    libssl-dev \
    libyaml-dev \
    git \
    build-essential \
    clang \
    cmake \
    ocl-icd-opencl-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY tools/acc_bridge/requirements_jetson.txt /tmp/requirements_jetson.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements_jetson.txt

# Install onnxruntime with TensorRT support for Jetson
# The NVIDIA Jetson onnxruntime-gpu wheel includes TensorRT EP
RUN pip3 install --no-cache-dir onnxruntime-gpu || \
    pip3 install --no-cache-dir onnxruntime

# Copy openpilot source
COPY . /openpilot
WORKDIR /openpilot

# Build cereal messaging
RUN cd cereal && \
    pip3 install --no-cache-dir cython pycapnp && \
    python3 setup.py build_ext --inplace || true

# Build opendbc CAN packer
RUN cd opendbc && \
    scons -j$(nproc) || true

# Build boardd API
RUN cd selfdrive/boardd && \
    scons -j$(nproc) || true

# Build modeld with ONNX + TensorRT (USE_NVIDIA_GPU skips Qualcomm SNPE/Thneed)
ENV USE_NVIDIA_GPU=1
RUN scons -j$(nproc) selfdrive/modeld || true

# Fetch model file (git LFS)
RUN cd models && \
    git lfs pull --include="supercombo.onnx" || true

# Pre-create TensorRT engine cache directory
RUN mkdir -p /openpilot/models/trt_cache

ENV PYTHONPATH=/openpilot
ENV SIMULATION=1
ENV NOSENSOR=1

WORKDIR /openpilot/tools/acc_bridge

ENTRYPOINT ["python3", "bridge.py"]
CMD ["--cam-backend", "gstreamer", "--cam-source", "auto"]
